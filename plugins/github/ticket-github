#!/usr/bin/env bash
# tk-plugin: Import GitHub issues and pull requests into local tickets (one-way)
# tk-plugin-version: 0.5.1

set -euo pipefail

VERSION="0.5.1"

# Find tk executable if TK_SCRIPT not passed
if [[ -z "${TK_SCRIPT:-}" ]]; then
    if command -v tk &>/dev/null; then
        TK_SCRIPT="tk"
    elif command -v ticket &>/dev/null; then
        TK_SCRIPT="ticket"
    else
        echo "Error: tk executable not found in PATH." >&2
        exit 1
    fi
fi

# Find tickets directory if TICKETS_DIR not passed
if [[ -z "${TICKETS_DIR:-}" ]]; then
    dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.tickets" ]]; then
            TICKETS_DIR="$dir/.tickets"
            break
        fi
        dir=$(dirname "$dir")
    done
    TICKETS_DIR="${TICKETS_DIR:-.tickets}"
fi

show_help() {
    cat << EOF
tk-github (v${VERSION}) — Import GitHub issues and pull requests into local tk tickets (one-way).
Created by Sampath Kumar & wedow contributors
GitHub: https://github.com/msampathkumar/ticket
License: MIT

Usage: tk github <command> [options]

Commands:
  sync                     Import GitHub issues and/or PRs; nothing is written to GitHub (default)
  unsync [--force|-y]      Remove all tickets created by github-sync
  list | status            List all locally synced GitHub tickets
  version | --version | -v Display plugin version
  help | --help | -h       Display this help message

Options:
  --issues                 Import only GitHub issues
  --prs                    Import only GitHub pull requests
  --all                    Import both issues and pull requests (default)
  --repo <owner/repo>      Target a specific GitHub repository
  --limit <N>              Max number of issues/PRs to fetch (default: 50)
  --force, -y              Bypass confirmation prompt on unsync

Examples:
  tk github sync           # Import both issues and PRs from current repo
  tk github sync --issues  # Import only issues
  tk github sync --prs     # Import only pull requests
  tk github list           # View all synced tickets
  tk github unsync -y      # Remove all synced GitHub tickets

Thank you for using tk! If you find it helpful, please star the repo or contribute on GitHub.
EOF
}

cmd_version() {
    cat << EOF
tk-github version ${VERSION}

Sync GitHub issues and pull requests into local tk tickets.
Created by Sampath Kumar & wedow contributors
GitHub: https://github.com/msampathkumar/ticket
License: MIT

Thank you for using tk! If you find it helpful, please star the repo or contribute on GitHub.
EOF
}

check_gh_cli() {
    if ! command -v gh &>/dev/null; then
        echo "Error: GitHub CLI ('gh') is required for tk-github." >&2
        echo "Please install gh: https://cli.github.com" >&2
        exit 1
    fi

    if ! gh auth status &>/dev/null; then
        echo "Error: GitHub CLI is not authenticated. Run 'gh auth login' first." >&2
        exit 1
    fi
}

find_local_ticket_by_ref() {
    local ref="$1"
    if [[ ! -d "$TICKETS_DIR" ]]; then
        return 1
    fi
    for file in "$TICKETS_DIR"/*.md; do
        [[ -f "$file" ]] || continue
        if grep -q -E "^(external-ref|external_ref): $ref$" "$file" 2>/dev/null; then
            awk -F': ' '/^id:/{print $2; exit}' "$file"
            return 0
        fi
    done
    return 1
}

find_local_ticket_status() {
    local tid="$1"
    local file="$TICKETS_DIR/$tid.md"
    if [[ -f "$file" ]]; then
        awk -F': ' '/^status:/{print $2; exit}' "$file"
    fi
}

# Ensure an existing synced ticket carries the sync tags (github-sync, pr|issue, GitHub labels).
# Legacy variants of the item's labels written by older versions (raw label text, read here
# space-stripped, e.g. `autorelease:pending`) are replaced by the sanitised tag ($3).
# Duplicates are dropped. Other tags the user added locally (e.g. `taskforce`) are preserved.
# Prints "updated" when the ticket was changed so callers can count it.
ensure_ticket_tags() {
    local tid="$1" wanted_csv="$2" legacy_csv="${3:-}"
    local file="$TICKETS_DIR/$tid.md"
    [[ -f "$file" ]] || return 0
    local current_csv
    current_csv=$(awk '/^---$/{c++; next} c==1 && /^tags:/{sub(/^tags:[ ]*\[/, ""); sub(/\][ ]*$/, ""); gsub(/ /, ""); print; exit}' "$file")
    local merged="" t
    IFS=',' read -ra current <<< "$current_csv"
    for t in "${current[@]}"; do
        [[ -z "$t" ]] && continue
        # Drop legacy label variants unless the variant is itself a wanted tag.
        if [[ ",$legacy_csv," == *",$t,"* && ",$wanted_csv," != *",$t,"* ]]; then
            continue
        fi
        [[ ",$merged," == *",$t,"* ]] || merged="${merged:+$merged,}$t"
    done
    IFS=',' read -ra wanted <<< "$wanted_csv"
    for t in "${wanted[@]}"; do
        [[ -z "$t" ]] && continue
        [[ ",$merged," == *",$t,"* ]] || merged="${merged:+$merged,}$t"
    done
    if [[ "$merged" != "$current_csv" ]]; then
        "$TK_SCRIPT" super update "$tid" --tags "$merged" >/dev/null && echo "updated"
    fi
}

# Legacy tag variants of item $2's labels in JSON array $1, as older versions wrote them:
# raw label text split on commas, with spaces removed (matching how ensure_ticket_tags reads tags).
gh_labels_legacy_csv() {
    echo "$1" | jq -r --argjson i "$2" \
        '.[$i].labels[]?.name | split(",")[] | gsub(" "; "") | select(length > 0)' \
        2>/dev/null | paste -sd, - || true
}

# GitHub label names -> comma-separated tk tags for item $2 of JSON array $1.
# Labels are attacker-controlled. Tags end up in a YAML flow list and in a sed replacement
# (update_yaml_field), so anything outside letters, digits and `_ . # + -` becomes '-',
# and leading/trailing '-' are stripped. Commas cannot split one label into several tags.
gh_labels_csv() {
    echo "$1" | jq -r --argjson i "$2" \
        '.[$i].labels[]?.name | gsub("[^\\p{L}\\p{N}_.#+-]+"; "-") | sub("^-+"; "") | sub("-+$"; "") | select(length > 0)' \
        2>/dev/null | paste -sd, - || true
}

# Title of item $2 of JSON array $1, on a single line.
gh_title() {
    echo "$1" | jq -r --argjson i "$2" '.[$i].title // "" | gsub("[\\r\\n]+"; " ")'
}

# Create a local ticket from a GitHub item and print its ID.
# Usage: create_imported_ticket <title> <placeholder> <type> <ext_ref> <tags> <description>
# `tk create` reads the title as a bare positional argument and has no `--` terminator, so a
# title starting with '-' (e.g. "--help", "-d x") would be parsed as an option. Such titles are
# created with a safe placeholder and then set via `update --title`, whose value tk reads verbatim.
# All other values are passed as option arguments, which tk also reads verbatim.
create_imported_ticket() {
    local title="$1" placeholder="$2" type="$3" ext_ref="$4" tags="$5" desc="$6"
    local create_title="$title" new_id
    [[ "$title" == -* ]] && create_title="$placeholder"
    new_id=$("$TK_SCRIPT" super create "$create_title" -t "$type" --external-ref "$ext_ref" --tags "$tags" -d "$desc") || return 1
    if [[ "$create_title" != "$title" ]]; then
        "$TK_SCRIPT" super update "$new_id" --title "$title" >/dev/null || return 1
    fi
    echo "$new_id"
}

cmd_sync() {
    check_gh_cli
    mkdir -p "$TICKETS_DIR"

    local sync_issues=1
    local sync_prs=1
    local repo_flag=""
    local limit=50

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --issues) sync_prs=0; shift ;;
            --prs) sync_issues=0; shift ;;
            --all) sync_issues=1; sync_prs=1; shift ;;
            --repo) repo_flag="-R $2"; shift 2 ;;
            --repo=*) repo_flag="-R ${1#--repo=}"; shift ;;
            --limit) limit="$2"; shift 2 ;;
            --limit=*) limit="${1#--limit=}"; shift ;;
            *) shift ;;
        esac
    done

    echo "🔄 Starting GitHub sync for tickets in $TICKETS_DIR..."
    local created_count=0
    local closed_count=0
    local existing_count=0
    local retagged_count=0

    # 1. Sync Issues
    if [[ $sync_issues -eq 1 ]]; then
        echo "📥 Fetching GitHub issues (limit: $limit)..."
        local issues_json
        issues_json=$(gh issue list $repo_flag --limit "$limit" --state all --json number,title,body,url,state,labels 2>/dev/null || echo "[]")
        
        local count
        count=$(echo "$issues_json" | jq '. | length' 2>/dev/null || echo 0)

        for ((i=0; i<count; i++)); do
            local num title body url state labels_str legacy_str ext_ref
            num=$(echo "$issues_json" | jq -r ".[$i].number")
            title=$(gh_title "$issues_json" "$i")
            body=$(echo "$issues_json" | jq -r ".[$i].body // \"\"")
            url=$(echo "$issues_json" | jq -r ".[$i].url")
            state=$(echo "$issues_json" | jq -r ".[$i].state")
            labels_str=$(gh_labels_csv "$issues_json" "$i")
            legacy_str=$(gh_labels_legacy_csv "$issues_json" "$i")

            ext_ref="gh-issue-$num"
            local tags="github-sync,github,issue,issue#$num"
            [[ -n "$labels_str" ]] && tags="$tags,$labels_str"
            local local_id
            if local_id=$(find_local_ticket_by_ref "$ext_ref"); then
                local local_status
                local_status=$(find_local_ticket_status "$local_id")
                # Always (re)apply sync tags + labels so edited/stripped tickets are repaired on re-sync.
                if [[ -n "$(ensure_ticket_tags "$local_id" "$tags" "$legacy_str")" ]]; then
                    echo "  🏷️  Re-tagged local ticket $local_id (Issue #$num) with $tags"
                    retagged_count=$((retagged_count + 1))
                fi
                if [[ "$state" == "CLOSED" && "$local_status" != "closed" ]]; then
                    "$TK_SCRIPT" super close "$local_id" >/dev/null
                    echo "  ✅ Closed local ticket $local_id (Issue #$num closed on GitHub)"
                    closed_count=$((closed_count + 1))
                else
                    existing_count=$((existing_count + 1))
                fi
            else
                if [[ "$state" == "OPEN" ]]; then
                    local desc_body="$body"
                    if [[ -z "${desc_body// /}" ]]; then
                        desc_body="*(No description provided on GitHub)*"
                    fi
                    local full_desc="${desc_body}"$'\n\n'"**GitHub URL:** $url"
                    local new_id
                    new_id=$(create_imported_ticket "$title" "GitHub issue #$num" bug "$ext_ref" "$tags" "$full_desc")
                    echo "  ✨ Created local ticket $new_id for Issue #$num ($title)"
                    created_count=$((created_count + 1))
                fi
            fi
        done
    fi

    # 2. Sync Pull Requests
    if [[ $sync_prs -eq 1 ]]; then
        echo "📥 Fetching GitHub pull requests (limit: $limit)..."
        local prs_json
        prs_json=$(gh pr list $repo_flag --limit "$limit" --state all --json number,title,body,url,state,labels 2>/dev/null || echo "[]")
        
        local pr_count
        pr_count=$(echo "$prs_json" | jq '. | length' 2>/dev/null || echo 0)

        for ((i=0; i<pr_count; i++)); do
            local num title body url state labels_str legacy_str ext_ref
            num=$(echo "$prs_json" | jq -r ".[$i].number")
            title=$(gh_title "$prs_json" "$i")
            body=$(echo "$prs_json" | jq -r ".[$i].body // \"\"")
            url=$(echo "$prs_json" | jq -r ".[$i].url")
            state=$(echo "$prs_json" | jq -r ".[$i].state")
            labels_str=$(gh_labels_csv "$prs_json" "$i")
            legacy_str=$(gh_labels_legacy_csv "$prs_json" "$i")

            ext_ref="gh-pr-$num"
            local tags="github-sync,github,pr,pr#$num"
            [[ -n "$labels_str" ]] && tags="$tags,$labels_str"
            local local_id
            if local_id=$(find_local_ticket_by_ref "$ext_ref"); then
                local local_status
                local_status=$(find_local_ticket_status "$local_id")
                # Always (re)apply sync tags + labels so edited/stripped tickets are repaired on re-sync.
                if [[ -n "$(ensure_ticket_tags "$local_id" "$tags" "$legacy_str")" ]]; then
                    echo "  🏷️  Re-tagged local ticket $local_id (PR #$num) with $tags"
                    retagged_count=$((retagged_count + 1))
                fi
                if [[ ("$state" == "MERGED" || "$state" == "CLOSED") && "$local_status" != "closed" ]]; then
                    "$TK_SCRIPT" super close "$local_id" >/dev/null
                    echo "  ✅ Closed local ticket $local_id (PR #$num $state on GitHub)"
                    closed_count=$((closed_count + 1))
                else
                    existing_count=$((existing_count + 1))
                fi
            else
                if [[ "$state" == "OPEN" ]]; then
                    local desc_body="$body"
                    if [[ -z "${desc_body// /}" ]]; then
                        desc_body="*(No description provided on GitHub)*"
                    fi
                    local full_desc="${desc_body}"$'\n\n'"**GitHub URL:** $url"
                    local new_id
                    new_id=$(create_imported_ticket "$title" "GitHub PR #$num" task "$ext_ref" "$tags" "$full_desc")
                    echo "  ✨ Created local ticket $new_id for PR #$num ($title)"
                    created_count=$((created_count + 1))
                fi
            fi
        done
    fi

    echo ""
    echo "🎉 Sync finished: $created_count created, $closed_count closed, $retagged_count re-tagged, $existing_count up to date."
}

cmd_unsync() {
    local force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-y) force=1; shift ;;
            *) shift ;;
        esac
    done

    if [[ ! -d "$TICKETS_DIR" ]]; then
        echo "No .tickets directory found."
        return 0
    fi

    local synced_files=()
    for file in "$TICKETS_DIR"/*.md; do
        [[ -f "$file" ]] || continue
        if grep -q "github-sync" "$file" 2>/dev/null; then
            synced_files+=("$file")
        fi
    done

    local count="${#synced_files[@]}"
    if [[ $count -eq 0 ]]; then
        echo "ℹ️ No GitHub-synced tickets found in $TICKETS_DIR."
        return 0
    fi

    echo "Found $count ticket(s) with tag 'github-sync'."
    if [[ $force -eq 0 ]]; then
        read -r -p "Are you sure you want to permanently delete these $count ticket(s)? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            return 0
        fi
    fi

    for file in "${synced_files[@]}"; do
        local id
        id=$(basename "$file" .md)
        rm -f "$file"
        echo "  🗑️ Deleted $id"
    done

    echo "✅ Removed $count GitHub-synced ticket(s)."
}

cmd_list() {
    if [[ ! -d "$TICKETS_DIR" ]]; then
        echo "No .tickets directory found."
        return 0
    fi

    echo "📋 GitHub-Synced Tickets in $TICKETS_DIR:"
    printf "%-10s %-12s %-10s %-16s %s\n" "ID" "STATUS" "TYPE" "REF" "TITLE"
    echo "----------------------------------------------------------------------"

    for file in "$TICKETS_DIR"/*.md; do
        [[ -f "$file" ]] || continue
        if grep -q "github-sync" "$file" 2>/dev/null; then
            local id status type ref title
            id=$(awk -F': ' '/^id:/{print $2; exit}' "$file")
            status=$(awk -F': ' '/^status:/{print $2; exit}' "$file")
            type=$(awk -F': ' '/^type:/{print $2; exit}' "$file")
            ref=$(awk -F': ' '/^(external-ref|external_ref):/{print $2; exit}' "$file")
            title=$(awk -F'# ' '/^# /{print $2; exit}' "$file")
            printf "%-10s [%-8s] %-10s %-16s %s\n" "$id" "$status" "$type" "${ref:-—}" "$title"
        fi
    done
}

# Main entry point
case "${1:-sync}" in
    sync)
        shift
        cmd_sync "$@"
        ;;
    unsync)
        shift
        cmd_unsync "$@"
        ;;
    list|status)
        shift
        cmd_list "$@"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    --tk-describe)
        echo "tk-plugin: Import GitHub issues and pull requests into local tickets (one-way)"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        # Treat unknown options as arguments to sync (e.g. tk github --issues)
        if [[ "$1" == --* ]]; then
            cmd_sync "$@"
        else
            echo "Error: unknown command '$1'" >&2
            echo "" >&2
            echo "Run 'tk github help' to see available commands." >&2
            exit 1
        fi
        ;;
esac
