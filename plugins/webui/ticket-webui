#!/usr/bin/env bash
# tk-plugin: Interactive Kanban Web UI & PR review dashboard
# tk-plugin-version: 0.4.0
set -e

resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

PLUGIN_DIR="${TK_WEBUI_HOME:-$(resolve_script_dir)}"
REPO_ROOT="$(cd "$PLUGIN_DIR/../.." >/dev/null 2>&1 && pwd || echo "")"

if [[ ! -f "$REPO_ROOT/pyproject.toml" && -n "${TK_REPO_DIR:-}" && -f "$TK_REPO_DIR/pyproject.toml" ]]; then
    REPO_ROOT="$TK_REPO_DIR"
fi

# Self-healing check: verify venv python and tk_webui module
if [ ! -x "$REPO_ROOT/.venv/bin/python3" ] || ! "$REPO_ROOT/.venv/bin/python3" -c "import tk_webui" &>/dev/null; then
    echo "📦 tk-webui environment is missing or incomplete." >&2
    if [ -x "$REPO_ROOT/install.sh" ]; then
        echo "⚙️  Initializing environment via $REPO_ROOT/install.sh --webui..." >&2
        (cd "$REPO_ROOT" && ./install.sh --webui) || {
            echo "❌ Failed to initialize tk-webui environment." >&2
            echo "👉 Please run: cd \"$REPO_ROOT\" && ./install.sh --webui" >&2
            exit 1
        }
    else
        echo "❌ Error: Could not find Python environment at $REPO_ROOT/.venv" >&2
        exit 1
    fi
fi

exec "$REPO_ROOT/.venv/bin/python3" -m tk_webui.main "$@"
